rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function donationPath(id) { return /databases/$(database)/documents/donations/$(id); }
    function organizationPath(id) { return /databases/$(database)/documents/organizations/$(id); }
    function sponsorshipPath(id) { return /databases/$(database)/documents/sponsorships/$(id); }
    function isAdmin() { return signedIn() && get(userPath(request.auth.uid)).data.role == 'admin'; }
    function ownsOrganization(id) {
      return signedIn() && get(organizationPath(id)).data.ownerUserId == request.auth.uid;
    }
    function hasOrganization() {
      return signedIn() && ownsOrganization(get(userPath(request.auth.uid)).data.organizationId);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'user' && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.email == resource.data.email &&
         request.resource.data.get('organizationId', null) ==
           resource.data.get('organizationId', null));
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.donorId == request.auth.uid;
      allow update: if signedIn() &&
        request.resource.data.donorId == resource.data.donorId &&
        (resource.data.donorId == request.auth.uid || hasOrganization());
      allow delete: if signedIn() && resource.data.donorId == request.auth.uid;
    }

    match /organizationApplications/{applicationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && request.resource.data.userId == resource.data.userId &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow get: if signedIn() && (resource == null ||
        resource.data.donorId == request.auth.uid ||
        resource.data.requestedBy == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.donorId == request.auth.uid ||
        resource.data.requestedBy == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.requestedBy == request.auth.uid &&
        ownsOrganization(request.resource.data.organizationId) &&
        request.resource.data.donorId == get(donationPath(orderId)).data.donorId;
      allow update: if signedIn() &&
        (resource.data.donorId == request.auth.uid ||
         resource.data.requestedBy == request.auth.uid) &&
        request.resource.data.donorId == resource.data.donorId &&
        request.resource.data.requestedBy == resource.data.requestedBy;
      allow delete: if false;
    }

    match /sponsorships/{sponsorshipId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUserId == request.auth.uid &&
        ownsOrganization(request.resource.data.organizationId);
      allow update: if signedIn() &&
        resource.data.ownerUserId != 'foodbridge-seed-organization' &&
        request.auth.uid != resource.data.ownerUserId &&
        request.resource.data.ownerUserId == resource.data.ownerUserId;
      allow delete: if false;

      match /pledges/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId ||
          get(sponsorshipPath(sponsorshipId)).data.ownerUserId == request.auth.uid);
        allow create: if signedIn() && request.auth.uid == userId &&
          request.resource.data.userId == userId &&
          get(sponsorshipPath(sponsorshipId)).data.ownerUserId != userId &&
          get(sponsorshipPath(sponsorshipId)).data.ownerUserId != 'foodbridge-seed-organization';
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid;
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid &&
        request.resource.data.recipientId == resource.data.recipientId;
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
